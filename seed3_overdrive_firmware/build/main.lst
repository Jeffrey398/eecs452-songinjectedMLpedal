   1:knob_protocol.h **** // knob_protocol.h - the USB serial protocol between the Pi and the Seed3.
   2:knob_protocol.h **** //
   3:knob_protocol.h **** //   Pi -> Seed3 :  "drive,tone,level\n"   three numbers 0..1, e.g. "0.7500,0.4000,0.5000\n"
   4:knob_protocol.h **** //                  "drive,tone\n"         two numbers also accepted (level unchanged)
   5:knob_protocol.h **** //                  "bypass\n"             back to a clean pass-through
   6:knob_protocol.h **** //                  "ping\n"               connectivity check
   7:knob_protocol.h **** //   Seed3 -> Pi :  "OK d,t,l"             accepted values x1000 as integers
   8:knob_protocol.h **** //                  "PONG" / "OK bypass"
   9:knob_protocol.h **** //                  "ERR <reason>"         line rejected, previous settings kept
  10:knob_protocol.h **** //
  11:knob_protocol.h **** // Header-only and free of libDaisy, so it is tested on a laptop (tests/).
  12:knob_protocol.h **** #pragma once
  13:knob_protocol.h **** 
  14:knob_protocol.h **** #include <cmath>
  15:knob_protocol.h **** #include <cstddef>
  16:knob_protocol.h **** #include <cstdint>
