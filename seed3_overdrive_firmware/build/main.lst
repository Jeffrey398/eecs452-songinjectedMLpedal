  22:knob_protocol.h **** 
  23:knob_protocol.h **** enum class ParseResult { Ok, Empty, WrongCount, BadNumber, NotFinite, TrailingJunk };
  24:knob_protocol.h **** 
  25:knob_protocol.h **** inline const char* ParseResultName(ParseResult r)
  26:knob_protocol.h **** {
  27:knob_protocol.h ****     switch(r)
  28:knob_protocol.h ****     {
  29:knob_protocol.h ****         case ParseResult::Ok: return "ok";
  30:knob_protocol.h ****         case ParseResult::Empty: return "empty";
  31:knob_protocol.h ****         case ParseResult::WrongCount: return "wrong_count";
  32:knob_protocol.h ****         case ParseResult::BadNumber: return "bad_number";
  33:knob_protocol.h ****         case ParseResult::NotFinite: return "not_finite";
  34:knob_protocol.h ****         case ParseResult::TrailingJunk: return "trailing_junk";
  35:knob_protocol.h ****     }
  36:knob_protocol.h ****     return "unknown";
  37:knob_protocol.h **** }
  38:knob_protocol.h **** 
  39:knob_protocol.h **** inline const char* SkipSpace(const char* p)
  40:knob_protocol.h **** {
  41:knob_protocol.h ****     while(*p == ' ' || *p == '\t') ++p;
  42:knob_protocol.h ****     return p;
  43:knob_protocol.h **** }
  44:knob_protocol.h **** 
  45:knob_protocol.h **** // Parses two or three comma-separated numbers into *k (clamped to 0..1). With two numbers
  46:knob_protocol.h **** // only drive and tone change. On failure *k is untouched.
  47:knob_protocol.h **** inline ParseResult ParseKnobLine(const char* line, Knobs* k)
  48:knob_protocol.h **** {
  49:knob_protocol.h ****     float       v[3];
  50:knob_protocol.h ****     int         n = 0;
  51:knob_protocol.h ****     const char* p = SkipSpace(line);
  52:knob_protocol.h ****     if(*p == '\0') return ParseResult::Empty;
  53:knob_protocol.h **** 
  54:knob_protocol.h ****     for(;;)
  55:knob_protocol.h ****     {
ARM GAS  /tmp/ccaD1KAK.s 			page 11


  56:knob_protocol.h ****         p = SkipSpace(p);
  57:knob_protocol.h ****         char* end = nullptr;
  58:knob_protocol.h ****         float f   = std::strtof(p, &end);
  59:knob_protocol.h ****         if(end == p) return (*p == '\0') ? ParseResult::WrongCount : ParseResult::BadNumber;
  60:knob_protocol.h ****         if(!std::isfinite(f)) return ParseResult::NotFinite;
  61:knob_protocol.h ****         if(n == 3) return ParseResult::WrongCount;
  62:knob_protocol.h ****         v[n++] = f;
  63:knob_protocol.h ****         p      = SkipSpace(end);
  64:knob_protocol.h ****         if(*p == ',') { ++p; continue; }
  65:knob_protocol.h ****         break;
  66:knob_protocol.h ****     }
  67:knob_protocol.h ****     if(*p != '\0') return ParseResult::TrailingJunk;
  68:knob_protocol.h ****     if(n < 2) return ParseResult::WrongCount;
  69:knob_protocol.h **** 
  70:knob_protocol.h ****     Knobs q = *k;
  71:knob_protocol.h ****     q.drive = v[0];
  72:knob_protocol.h ****     q.tone  = v[1];
  73:knob_protocol.h ****     if(n == 3) q.level = v[2];
  74:knob_protocol.h ****     ClampKnobs(&q);
  75:knob_protocol.h ****     *k = q;
  76:knob_protocol.h ****     return ParseResult::Ok;
  77:knob_protocol.h **** }
  78:knob_protocol.h **** 
  79:knob_protocol.h **** // Case-insensitive match against a command word (no allocation, no libc extras).
  80:knob_protocol.h **** inline bool IsCommand(const char* line, const char* word)
  81:knob_protocol.h **** {
  82:knob_protocol.h ****     line = SkipSpace(line);
  83:knob_protocol.h ****     while(*word)
  84:knob_protocol.h ****     {
  85:knob_protocol.h ****         char a = *line, b = *word;
  86:knob_protocol.h ****         if(a >= 'A' && a <= 'Z') a = static_cast<char>(a - 'A' + 'a');
  87:knob_protocol.h ****         if(a != b) return false;
  88:knob_protocol.h ****         ++line; ++word;
  89:knob_protocol.h ****     }
  90:knob_protocol.h ****     return *SkipSpace(line) == '\0';
  91:knob_protocol.h **** }
