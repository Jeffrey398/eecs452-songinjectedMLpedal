   1:overdrive_dsp.h **** // overdrive_dsp.h - Wiener-Hammerstein overdrive for the Seed3, driven by three knobs.
   2:overdrive_dsp.h **** //
   3:overdrive_dsp.h **** //        x --> [ H1: input filter ] --> u --> [ f: static nonlinearity ] --> v --> [ H2: output fi
   4:overdrive_dsp.h **** //
   5:overdrive_dsp.h **** //   H1  : high-pass + mid hump           (2 biquads)
   6:overdrive_dsp.h **** //   f   : y = (tanh(g*u + b) - tanh(b)) / tanh(g)     g = drive gain, b = small asymmetry
   7:overdrive_dsp.h **** //   H2  : tone low-pass + DC blocker     (1 biquad + 1 one-pole)
   8:overdrive_dsp.h **** //   level: output gain
   9:overdrive_dsp.h **** //
  10:overdrive_dsp.h **** // THE NUMBERS BELOW ARE PLACEHOLDERS, NOT FITTED TO THE REAL PEDAL. The structure,
  11:overdrive_dsp.h **** // the knob interface and the real-time plumbing are final; MapKnobs() is the one place
  12:overdrive_dsp.h **** // where fitted values go. Replace its formulas (or make it interpolate a table measured
  13:overdrive_dsp.h **** // on the 5x5 drive/tone grid) with the parameters identified from the recordings.
  14:overdrive_dsp.h **** //
  15:overdrive_dsp.h **** // Header-only, no libDaisy dependency, so it can be tested on a laptop (tests/).
  16:overdrive_dsp.h **** #pragma once
  17:overdrive_dsp.h **** 
  18:overdrive_dsp.h **** #include <cmath>
  19:overdrive_dsp.h **** #include <cstddef>
  20:overdrive_dsp.h **** 
  21:overdrive_dsp.h **** namespace od {
  22:overdrive_dsp.h **** 
  23:overdrive_dsp.h **** // All three knobs are normalised 0..1, as sent by the Pi.
  24:overdrive_dsp.h **** struct Knobs
  25:overdrive_dsp.h **** {
  26:overdrive_dsp.h ****     float drive = 0.5f;
  27:overdrive_dsp.h ****     float tone  = 0.5f;
  28:overdrive_dsp.h ****     float level = 0.5f;
  29:overdrive_dsp.h **** };
  30:overdrive_dsp.h **** 
  31:overdrive_dsp.h **** inline float Clamp01(float v) { return v < 0.0f ? 0.0f : (v > 1.0f ? 1.0f : v); }
  32:overdrive_dsp.h **** 
  33:overdrive_dsp.h **** inline void ClampKnobs(Knobs* k)
  34:overdrive_dsp.h **** {
  35:overdrive_dsp.h ****     k->drive = Clamp01(k->drive);
  36:overdrive_dsp.h ****     k->tone  = Clamp01(k->tone);
  37:overdrive_dsp.h ****     k->level = Clamp01(k->level);
  38:overdrive_dsp.h **** }
  39:overdrive_dsp.h **** 
  40:overdrive_dsp.h **** // Everything the Wiener-Hammerstein model needs for one knob setting.
  41:overdrive_dsp.h **** struct WhParams
ARM GAS  /tmp/ccaD1KAK.s 			page 17


  42:overdrive_dsp.h **** {
  43:overdrive_dsp.h ****     // H1: input filter
  44:overdrive_dsp.h ****     double h1_hp_hz   = 80.0;     // high-pass corner
  45:overdrive_dsp.h ****     double h1_mid_hz  = 720.0;    // mid hump centre
  46:overdrive_dsp.h ****     double h1_mid_db  = 4.0;
  47:overdrive_dsp.h ****     double h1_mid_q   = 0.8;
  48:overdrive_dsp.h ****     // f: static nonlinearity
  49:overdrive_dsp.h ****     float  nl_gain    = 1.0f;     // g
  50:overdrive_dsp.h ****     float  nl_bias    = 0.0f;     // b
  51:overdrive_dsp.h ****     // H2: output filter
  52:overdrive_dsp.h ****     double h2_lp_hz   = 4000.0;   // tone low-pass corner
  53:overdrive_dsp.h ****     // level
  54:overdrive_dsp.h ****     float  out_gain   = 1.0f;
  55:overdrive_dsp.h **** };
  56:overdrive_dsp.h **** 
  57:overdrive_dsp.h **** // PLACEHOLDER knob -> model mapping. Replace with fitted values.
  58:overdrive_dsp.h **** inline WhParams MapKnobs(const Knobs& k)
  59:overdrive_dsp.h **** {
  60:overdrive_dsp.h ****     WhParams p;
  61:overdrive_dsp.h ****     p.nl_gain  = 1.0f + 49.0f * k.drive * k.drive;                  // 1 .. 50
  62:overdrive_dsp.h ****     p.nl_bias  = 0.10f * k.drive;                                   // slight asymmetry
  63:overdrive_dsp.h ****     p.h2_lp_hz = 800.0 * std::pow(2.0, 3.5 * (double)k.tone);        // 800 Hz .. ~9 kHz
  64:overdrive_dsp.h ****     p.out_gain = std::pow(10.0f, (k.level - 0.5f) * 18.0f / 20.0f);  // -9 .. +9 dB
  65:overdrive_dsp.h ****     return p;
  66:overdrive_dsp.h **** }
  67:overdrive_dsp.h **** 
  68:overdrive_dsp.h **** constexpr double kPi = 3.14159265358979323846;
  69:overdrive_dsp.h **** 
  70:overdrive_dsp.h **** // Direct form II transposed biquad, a0 normalised to 1. Coefficients may change while running.
  71:overdrive_dsp.h **** struct Biquad
  72:overdrive_dsp.h **** {
  73:overdrive_dsp.h ****     float b0 = 1, b1 = 0, b2 = 0, a1 = 0, a2 = 0, z1 = 0, z2 = 0;
  74:overdrive_dsp.h ****     void Set(double nb0, double nb1, double nb2, double na0, double na1, double na2)
  75:overdrive_dsp.h ****     {
  76:overdrive_dsp.h ****         b0 = (float)(nb0 / na0); b1 = (float)(nb1 / na0); b2 = (float)(nb2 / na0);
  77:overdrive_dsp.h ****         a1 = (float)(na1 / na0); a2 = (float)(na2 / na0);
  78:overdrive_dsp.h ****     }
  79:overdrive_dsp.h ****     float Process(float x)
  80:overdrive_dsp.h ****     {
  81:overdrive_dsp.h ****         const float y = b0 * x + z1;
  82:overdrive_dsp.h ****         z1 = b1 * x - a1 * y + z2;
  83:overdrive_dsp.h ****         z2 = b2 * x - a2 * y;
  84:overdrive_dsp.h ****         return y;
  85:overdrive_dsp.h ****     }
  86:overdrive_dsp.h **** };
  87:overdrive_dsp.h **** 
  88:overdrive_dsp.h **** // RBJ cookbook designs (Q = 1/sqrt(2) for the Butterworth-style high/low-pass)
  89:overdrive_dsp.h **** inline void DesignHighPass(Biquad* f, double fs, double f0, double q)
  90:overdrive_dsp.h **** {
  91:overdrive_dsp.h ****     const double w = 2 * kPi * f0 / fs, cw = std::cos(w), alpha = std::sin(w) / (2 * q);
  92:overdrive_dsp.h ****     f->Set((1 + cw) / 2, -(1 + cw), (1 + cw) / 2, 1 + alpha, -2 * cw, 1 - alpha);
  93:overdrive_dsp.h **** }
  94:overdrive_dsp.h **** inline void DesignLowPass(Biquad* f, double fs, double f0, double q)
  95:overdrive_dsp.h **** {
  96:overdrive_dsp.h ****     const double w = 2 * kPi * f0 / fs, cw = std::cos(w), alpha = std::sin(w) / (2 * q);
  97:overdrive_dsp.h ****     f->Set((1 - cw) / 2, 1 - cw, (1 - cw) / 2, 1 + alpha, -2 * cw, 1 - alpha);
  98:overdrive_dsp.h **** }
ARM GAS  /tmp/ccaD1KAK.s 			page 18


  99:overdrive_dsp.h **** inline void DesignPeaking(Biquad* f, double fs, double f0, double gain_db, double q)
 100:overdrive_dsp.h **** {
 101:overdrive_dsp.h ****     const double A = std::pow(10.0, gain_db / 40.0), w = 2 * kPi * f0 / fs;
 102:overdrive_dsp.h ****     const double cw = std::cos(w), alpha = std::sin(w) / (2 * q);
 103:overdrive_dsp.h ****     f->Set(1 + alpha * A, -2 * cw, 1 - alpha * A, 1 + alpha / A, -2 * cw, 1 - alpha / A);
 104:overdrive_dsp.h **** }
 105:overdrive_dsp.h **** 
 106:overdrive_dsp.h **** constexpr double kButterQ  = 0.70710678118654752;
 107:overdrive_dsp.h **** constexpr float  kSmoothMs = 20.0f;   // knob glide, avoids zipper noise
 108:overdrive_dsp.h **** constexpr float  kDcR      = 0.998f;  // output DC blocker pole (~15 Hz at 48 kHz)
 109:overdrive_dsp.h **** 
 110:overdrive_dsp.h **** class Overdrive
 111:overdrive_dsp.h **** {
 112:overdrive_dsp.h ****   public:
 113:overdrive_dsp.h ****     void Init(float sample_rate, size_t block_size)
 114:overdrive_dsp.h ****     {
 115:overdrive_dsp.h ****         sr_ = sample_rate;
 116:overdrive_dsp.h ****         glide_ = 1.0f - std::exp(-(static_cast<float>(block_size) / sr_) / (kSmoothMs / 1000.0f));
 117:overdrive_dsp.h ****         SnapToTarget();
 118:overdrive_dsp.h ****     }
 119:overdrive_dsp.h **** 
 120:overdrive_dsp.h ****     void SetTarget(const Knobs& k) { target_ = k; }
 121:overdrive_dsp.h **** 
 122:overdrive_dsp.h ****     // false = clean pass-through (start-up, and the BYPASS command), true = effect on.
 123:overdrive_dsp.h ****     void SetEngaged(bool on) { wet_target_ = on ? 1.0f : 0.0f; }
 124:overdrive_dsp.h **** 
 125:overdrive_dsp.h ****     // Jump straight to the targets (start-up and tests that need exact values).
 126:overdrive_dsp.h ****     void SnapToTarget()
 127:overdrive_dsp.h ****     {
 128:overdrive_dsp.h ****         cur_ = target_;
 129:overdrive_dsp.h ****         wet_ = wet_target_;
 130:overdrive_dsp.h ****         Derive();
 131:overdrive_dsp.h ****     }
 132:overdrive_dsp.h **** 
 133:overdrive_dsp.h ****     // Call once per audio block, before Process().
 134:overdrive_dsp.h ****     void UpdateBlock()
 135:overdrive_dsp.h ****     {
 136:overdrive_dsp.h ****         cur_.drive += glide_ * (target_.drive - cur_.drive);
 137:overdrive_dsp.h ****         cur_.tone  += glide_ * (target_.tone - cur_.tone);
 138:overdrive_dsp.h ****         cur_.level += glide_ * (target_.level - cur_.level);
 139:overdrive_dsp.h ****         wet_       += glide_ * (wet_target_ - wet_);
 140:overdrive_dsp.h ****         Derive();
 141:overdrive_dsp.h ****     }
 142:overdrive_dsp.h **** 
 143:overdrive_dsp.h ****     float Process(float x)
 144:overdrive_dsp.h ****     {
 145:overdrive_dsp.h ****         // H1
 146:overdrive_dsp.h ****         float u = h1_mid_.Process(h1_hp_.Process(x));
 147:overdrive_dsp.h ****         // f
 148:overdrive_dsp.h ****         float v = (std::tanh(p_.nl_gain * u + p_.nl_bias) - bias_t_) * nl_norm_;
 149:overdrive_dsp.h ****         // H2
 150:overdrive_dsp.h ****         float w = h2_lp_.Process(v);
 151:overdrive_dsp.h ****         float y = w - dc_x1_ + kDcR * dc_y1_;
 152:overdrive_dsp.h ****         dc_x1_ = w;
 153:overdrive_dsp.h ****         dc_y1_ = y;
 154:overdrive_dsp.h ****         y *= p_.out_gain;
 155:overdrive_dsp.h ****         y = y > 1.0f ? 1.0f : (y < -1.0f ? -1.0f : y);
ARM GAS  /tmp/ccaD1KAK.s 			page 19


 156:overdrive_dsp.h ****         // dry/wet crossfade lets the effect engage and disengage without a click
 157:overdrive_dsp.h ****         return x + wet_ * (y - x);
 158:overdrive_dsp.h ****     }
